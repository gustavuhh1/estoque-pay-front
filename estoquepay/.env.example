# Backend Better Auth (quando estiver pronto). Exemplo: http://localhost:3000/api/auth
VITE_BETTER_AUTH_URL=

# Modo demonstração (login local, aceita qualquer senha). Já fica ligado em `npm run dev`.
# Em build/deploy (ex.: apresentação), só liga com VITE_DEMO_MODE=true.
# Sem VITE_BETTER_AUTH_URL e sem este flag, o app mostra "Autenticação não configurada".
VITE_DEMO_MODE=
